# Optional overrides. Relative paths are resolved from the project root.
# Leave QWEN_TTS_DATA_DIR unset to keep an existing repository-local data/app.db.
# New installs may use %LOCALAPPDATA%/QwenTTSVoiceoverStudio automatically.
# QWEN_TTS_DATA_DIR=
QWEN_TTS_MODEL_ROOT=models
QWEN_TTS_GENERATION_MODEL_PATH=models/voice_design_1.7b
QWEN_TTS_CLONE_MODEL_PATH=models/voice_clone_1.7b

